# Cloudflare account and Pages configuration
# Copy this file to .env and fill in your real values.
# Do not commit .env with real secrets.

CF_ACCOUNT_ID=your_cloudflare_account_id_here
CF_API_TOKEN=your_cloudflare_api_token_here
CF_PROJECT_NAME=ledgerlocket
CF_BRANCH=main

# KV namespace IDs to bind to the function runtime names below
API_KEYS_KV_ID=replace-with-api-keys-kv-namespace-id
TRIALS_KV_ID=replace-with-trials-kv-namespace-id
NUMBERS_KV_ID=replace-with-numbers-kv-namespace-id
IDEMPOTENCY_KV_ID=replace-with-idempotency-kv-namespace-id
